{
  "name": "astrocalc-for-scioly-high",
  "version": "2.0.0",
  "description": "Comprehensive astronomy formula calculator for Science Olympiad",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:coverage": "playwright show-report",
    "test:expert": "playwright test tests/expert-system.test.js",
    "test:expert:coverage": "node scripts/tools/expertCoverage.js",
    "ci:expert": "npm run test:expert && npm run test:expert:coverage",
    "sync-katex": "rm -rf libs/katex && mkdir -p libs/katex && cp -R node_modules/katex/dist/* libs/katex/",
    "verify:formulas": "node scripts/tools/testAllFormulas.js",
    "verify:offline-precache": "node tools/verify-offline-precache.mjs",
    "test:offline": "playwright test tests/offline-pwa.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/node": "^20.19.27",
    "katex": "^0.16.11",
    "typescript": "^5.3.0"
  }
}
